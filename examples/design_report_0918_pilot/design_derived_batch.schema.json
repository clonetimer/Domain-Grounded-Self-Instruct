{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DGSI Design-derived intake batch v0.1",
  "type": "object",
  "required": [
    "batch_id",
    "schema_version",
    "source",
    "source_class",
    "candidate_class",
    "evidence_boundary",
    "counts",
    "source_facts",
    "candidates",
    "review_status",
    "training_authorized"
  ],
  "properties": {
    "batch_id": {
      "type": "string"
    },
    "schema_version": {
      "const": "dgsi-design-derived-intake.v0.1"
    },
    "source": {
      "type": "object",
      "required": [
        "source_id",
        "sha256",
        "filename",
        "source_track",
        "limitations"
      ],
      "properties": {
        "source_id": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "filename": {
          "type": "string"
        },
        "source_track": {
          "const": "KNOWLEDGE_SOURCE_NOT_EVENT"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "source_class": {
      "const": "KNOWLEDGE_SOURCE_NOT_EVENT"
    },
    "candidate_class": {
      "const": "DESIGN_DERIVED_HYPOTHETICAL"
    },
    "evidence_boundary": {
      "type": "string"
    },
    "counts": {
      "type": "object"
    },
    "source_facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "fact_id",
          "claim_type",
          "claim",
          "locator",
          "certainty",
          "boundary"
        ],
        "properties": {
          "fact_id": {
            "type": "string"
          },
          "claim_type": {
            "type": "string"
          },
          "claim": {
            "type": "string"
          },
          "locator": {
            "type": "string"
          },
          "certainty": {
            "const": "DESIGN_DECLARATION"
          },
          "boundary": {
            "type": "string"
          }
        }
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "case_id",
          "track",
          "task_type",
          "scenario_status",
          "scenario_assumption",
          "model_visible_input",
          "target",
          "source_fact_refs"
        ],
        "properties": {
          "case_id": {
            "type": "string"
          },
          "track": {
            "const": "DESIGN_DERIVED_HYPOTHETICAL"
          },
          "task_type": {
            "enum": [
              "diagnostic_synthesis",
              "historical_case_reuse",
              "conflict_reconciliation",
              "evidence_sufficiency",
              "next_step_recommendation",
              "handover_summary"
            ]
          },
          "scenario_status": {
            "const": "HYPOTHETICAL_NOT_OBSERVED"
          },
          "scenario_assumption": {
            "type": "string"
          },
          "model_visible_input": {
            "type": "object"
          },
          "target": {
            "type": "object",
            "required": [
              "decision",
              "reasoning_summary",
              "required_evidence",
              "certainty",
              "action_status"
            ],
            "properties": {
              "decision": {
                "const": "INCOMPLETE_EVIDENCE"
              },
              "reasoning_summary": {
                "type": "string"
              },
              "required_evidence": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "certainty": {
                "type": "string"
              },
              "action_status": {
                "type": "string"
              }
            }
          },
          "source_fact_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "review_status": {
      "const": "REVIEW_REQUIRED"
    },
    "training_authorized": {
      "const": false
    }
  },
  "additionalProperties": false
}
