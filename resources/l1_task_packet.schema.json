{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/clonetimer/Domain-Grounded-Self-Instruct/blob/main/resources/l1_task_packet.schema.json",
  "title": "DGSI L1 Diagnostic Task Packet v1",
  "description": "Curated L0-to-L1 task packet. It is not automatically a standalone SFT example or Gold record.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "track",
    "source_fact_refs",
    "case",
    "formal_target",
    "history_context",
    "synthetic_provenance",
    "review"
  ],
  "properties": {
    "schema_version": {
      "const": "dgsi-l1-task-packet.v1"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "track": {
      "enum": [
        "REAL_CASE_CANDIDATE",
        "LITERATURE_DERIVED_SYNTHETIC"
      ]
    },
    "source_fact_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "case": {
      "type": "object"
    },
    "formal_target": {
      "type": "object"
    },
    "history_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "mode",
        "retrieval_status",
        "query",
        "items"
      ],
      "properties": {
        "schema_version": {
          "const": "dgsi-history-context.v1"
        },
        "mode": {
          "const": "CONTEXT"
        },
        "retrieval_status": {
          "enum": [
            "HIT",
            "NO_HIT"
          ]
        },
        "query": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "equipment_scope",
            "subsystem",
            "mission_phase",
            "operating_mode"
          ],
          "properties": {
            "equipment_scope": {
              "type": "string",
              "minLength": 1
            },
            "subsystem": {
              "type": "string",
              "minLength": 1
            },
            "mission_phase": {
              "type": "string",
              "minLength": 1
            },
            "operating_mode": {
              "type": "string",
              "minLength": 1
            },
            "fault_modes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "configuration_keys": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "case_ref",
              "event_family_id",
              "outcome_status",
              "summary",
              "source_refs",
              "relevance_basis",
              "applicability_limitations",
              "hit_metadata",
              "historical_equipment_scope",
              "hardware_compatibility"
            ],
            "properties": {
              "case_ref": {
                "type": "string",
                "minLength": 1
              },
              "event_family_id": {
                "type": "string",
                "minLength": 1
              },
              "outcome_status": {
                "enum": [
                  "CONFIRMED",
                  "PARTIALLY_CONFIRMED",
                  "REJECTED",
                  "UNRESOLVED",
                  "UNKNOWN"
                ]
              },
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "source_refs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "relevance_basis": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "applicability_limitations": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "hit_metadata": {
                "type": "object"
              },
              "historical_equipment_scope": {
                "type": "string",
                "minLength": 1,
                "description": "Actual equipment scope of the retrieved prior case; distinct from the current query scope."
              },
              "hardware_compatibility": {
                "enum": [
                  "COMPATIBLE",
                  "INCOMPATIBLE",
                  "UNKNOWN"
                ],
                "description": "Explicit applicability judgment between historical and current equipment."
              }
            }
          }
        }
      }
    },
    "synthetic_provenance": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "classification",
            "generation_recipe",
            "recipe_version",
            "source_fact_refs",
            "generated_fields",
            "scenario_assumptions",
            "not_simulated",
            "expert_review_status",
            "gold_eligible",
            "real_flight_record"
          ],
          "properties": {
            "classification": {
              "const": "SYNTHETIC"
            },
            "generation_recipe": {
              "type": "string",
              "minLength": 1
            },
            "recipe_version": {
              "type": "string",
              "minLength": 1
            },
            "source_fact_refs": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            },
            "generated_fields": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "field_path",
                  "origin",
                  "source_fact_refs",
                  "assumption"
                ],
                "properties": {
                  "field_path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "origin": {
                    "enum": [
                      "DERIVED_FROM_SOURCE_FACT",
                      "SYNTHETIC_ASSUMPTION",
                      "SYNTHETIC_SCENARIO_VALUE"
                    ]
                  },
                  "source_fact_refs": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "assumption": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "scenario_assumptions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "not_simulated": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "expert_review_status": {
              "enum": [
                "NOT_REVIEWED",
                "REVIEW_REQUIRED",
                "REVIEWED_WITH_CHANGES",
                "APPROVED_FOR_SYNTHETIC_EXPERIMENT"
              ]
            },
            "gold_eligible": {
              "const": false
            },
            "real_flight_record": {
              "const": false
            }
          }
        }
      ]
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reviewer_id",
        "reviewed_at",
        "notes"
      ],
      "properties": {
        "status": {
          "enum": [
            "DRAFT",
            "REVIEW_REQUIRED",
            "APPROVED_FOR_L1_EXPERIMENT",
            "REJECTED"
          ]
        },
        "reviewer_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
