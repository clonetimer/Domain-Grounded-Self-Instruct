    {
      "term_id": "epc_twta",
      "preferred_zh": "电子功率调节器（TWTA用）",
      "preferred_en": "Electronic Power Conditioner (TWTA)",
      "definition_zh": "为行波管放大器提供所需稳定高压输出及相关控制、遥测和保护功能的电源设备。具体输出包括阴极、螺旋线、收集极及灯丝相关电压，取决于设计。",
      "status": "PROJECT_PREFERRED_TRANSLATION",
      "source_ids": [
        "ECSS_HV_HANDBOOK_2012",
        "TWTA_MICRODISCHARGE_2016",
        "JWST_TWTA_EPC_FAILURE_2024"
      ],
      "source_passage_ids": [
        "EPC_TWTA_HIGH_VOLTAGE_OUTPUTS",
        "EPC_TWTA_FUNCTIONAL_BLOCKS",
        "TWTA_MICRODISCHARGE_RESTART_SIGNATURE",
        "JWST_TWTA_EPC_PARTS_FAILURE_CASE"
      ],
      "aliases": [
        {
          "text": "EPC",
          "kind": "CONTEXTUAL_SHORT_FORM",
          "note": "仅在上下文明确为TWTA电源设备时使用；需与SSPA文献中的Electrical Power Conditioner语境区分。"
        }
      ],
      "related_terms": [
        {
          "text": "行波管",
          "kind": "RELATED_COMPONENT",
          "note": "TWT是EPC供电的真空电子器件，不是EPC本身。"
